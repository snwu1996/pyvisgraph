<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>pyvisgraph concave-boundary example - horseshoe exclusion zone</name>
    <!-- The 'boundary' is a horseshoe: a deep off-limits peninsula drops from
         the top edge and splits the navigable area into a left and a right
         arm joined only along the bottom. A path between the two arms must
         detour all the way around the peninsula. -->
    <Placemark>
      <name>boundary</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.000,51.000,0 6.100,51.000,0 6.100,51.050,0 6.058,51.050,0 6.058,51.014,0 6.042,51.014,0 6.042,51.050,0 6.000,51.050,0 6.000,51.000,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>left-arm block</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.015,51.030,0 6.028,51.030,0 6.028,51.038,0 6.015,51.038,0 6.015,51.030,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>right-arm block</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.072,51.030,0 6.085,51.030,0 6.085,51.038,0 6.072,51.038,0 6.072,51.030,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
  </Document>
</kml>
