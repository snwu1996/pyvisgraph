        <outerBoundaryIs><LinearRing><coordinates>
          6.080,51.010,0 6.110,51.010,0 6.110,51.045,0 6.100,51.045,0 6.100,51.020,0 6.090,51.020,0 6.090,51.045,0 6.080,51.045,0 6.080,51.010,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>star</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.0250,51.0800,0 6.0215,51.0699,0 6.0107,51.0696,0 6.0193,51.0631,0 6.0162,51.0529,0 6.0250,51.0590,0 6.0338,51.0529,0 6.0307,51.0631,0 6.0393,51.0696,0 6.0285,51.0699,0 6.0250,51.0800,0
