            6.085,51.075,0 6.100,51.075,0 6.0925,51.087,0 6.085,51.075,0
          </coordinates></LinearRing></outerBoundaryIs>
        </Polygon>
      </MultiGeometry>
    </Placemark>
    <Placemark>
      <name>square-with-hole</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.120,51.010,0 6.145,51.010,0 6.145,51.035,0 6.120,51.035,0 6.120,51.010,0
        </coordinates></LinearRing></outerBoundaryIs>
        <innerBoundaryIs><LinearRing><coordinates>
          6.128,51.018,0 6.137,51.018,0 6.137,51.027,0 6.128,51.027,0 6.128,51.018,0
