<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>pyvisgraph medium example - concave shapes, multi-geometry and a hole</name>
    <Placemark>
      <name>rectangle-a</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.010,51.010,0 6.030,51.010,0 6.030,51.020,0 6.010,51.020,0 6.010,51.010,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>rectangle-b</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.120,51.070,0 6.140,51.070,0 6.140,51.085,0 6.120,51.085,0 6.120,51.070,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>l-shape</name>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          6.040,51.010,0 6.070,51.010,0 6.070,51.020,0 6.050,51.020,0 6.050,51.045,0 6.040,51.045,0 6.040,51.010,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>u-shape</name>
